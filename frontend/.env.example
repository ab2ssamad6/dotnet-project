# Base URL of the LMS .NET API. Leave empty to use same-origin "/api"
# (recommended in production behind the bundled Nginx reverse proxy).
# For local dev against a separately running API, set e.g. http://localhost:8080
VITE_API_BASE_URL=

# Dev-only: where Vite's /api proxy forwards requests (see vite.config.ts).
VITE_PROXY_TARGET=http://localhost:8080
